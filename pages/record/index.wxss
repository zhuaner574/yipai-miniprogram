.record-page {
  padding-bottom: 80rpx;
  background:
    radial-gradient(circle at 90% 0%, rgba(226, 247, 111, 0.45), transparent 20%),
    #f7f5ec;
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.type-card {
  min-height: 142rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border: 2rpx solid rgba(25, 55, 47, 0.08);
  border-radius: 26rpx;
  background: #fffdf8;
}

.type-card.active {
  border-color: #19372f;
  background: #e2f76f;
  box-shadow: 0 10rpx 22rpx rgba(25, 55, 47, 0.08);
}

.type-icon {
  font-size: 34rpx;
  font-weight: 800;
}

.type-label {
  font-size: 24rpx;
  font-weight: 650;
}

.picker-shell {
  min-height: 90rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid rgba(25, 55, 47, 0.08);
  border-radius: 24rpx;
  background: #fffdf8;
  color: #51635a;
  font-size: 25rpx;
}

.picker-shell.full {
  width: 100%;
}

.optional {
  color: #98a29d;
  font-size: 21rpx;
  font-weight: 500;
}

.time-panel {
  overflow: hidden;
  border: 2rpx solid rgba(25, 55, 47, 0.08);
  border-radius: 30rpx;
  background: #fffdf8;
  box-shadow: 0 12rpx 28rpx rgba(34, 54, 46, 0.05);
}

.time-row {
  min-height: 116rpx;
  padding: 0 12rpx;
  display: flex;
  align-items: stretch;
}

.time-picker {
  flex: 1;
}

.time-control {
  height: 116rpx;
  padding: 0 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.time-control-label,
.time-control-value,
.duration-caption {
  display: block;
}

.time-control-label {
  color: #7b8982;
  font-size: 21rpx;
  font-weight: 600;
}

.time-control-value {
  margin-top: 8rpx;
  color: #19372f;
  font-size: 29rpx;
  font-weight: 760;
}

.time-divider {
  width: 2rpx;
  margin: 24rpx 0;
  background: rgba(25, 55, 47, 0.08);
}

.time-separator {
  height: 2rpx;
  margin: 0 28rpx;
  background: rgba(25, 55, 47, 0.07);
}

.duration-control {
  min-height: 118rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.duration-caption {
  margin-top: 7rpx;
  color: #a0aaa4;
  font-size: 20rpx;
}

.duration-value-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.duration-value-text {
  color: #19372f;
  font-size: 30rpx;
  font-weight: 780;
}

.picker-arrow {
  color: #7d8b83;
  font-size: 28rpx;
}

.end-time-strip {
  min-height: 66rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #edf5f1;
  color: #607269;
  font-size: 22rpx;
}

.end-time-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #e2f76f;
  box-shadow: 0 0 0 5rpx rgba(226, 247, 111, 0.28);
}

.match-panel {
  margin-top: 40rpx;
  padding: 30rpx;
  border: 2rpx solid rgba(25, 55, 47, 0.08);
  border-radius: 32rpx;
  background: #e7f2ee;
}

.match-title {
  display: block;
  font-size: 31rpx;
  font-weight: 780;
}

.match-entry-copy,
.match-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.match-entry-hint {
  color: #819087;
  font-size: 22rpx;
}

.match-entry {
  min-height: 92rpx;
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.78);
}

.match-entry-summary {
  flex: 1;
  color: #53675e;
  font-size: 24rpx;
  line-height: 1.5;
}

.match-entry-arrow {
  margin-left: 18rpx;
  font-size: 44rpx;
  font-weight: 400;
}

.result-row {
  display: flex;
  gap: 16rpx;
}

.match-format-row {
  display: flex;
  gap: 16rpx;
}

.match-format-card {
  flex: 1;
  min-height: 108rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
  font-weight: 720;
}

.match-format-card.active {
  border-color: #19372f;
  background: #e2f76f;
}

.placement-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.placement-chip {
  min-width: 132rpx;
  padding: 17rpx 22rpx;
  border: 2rpx solid rgba(25, 55, 47, 0.1);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  text-align: center;
  font-size: 24rpx;
}

.placement-chip.active {
  border-color: #19372f;
  background: #e2f76f;
  font-weight: 720;
}

.compact-input {
  margin-top: 14rpx;
}

.result-card {
  flex: 1;
  min-height: 116rpx;
  padding: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  font-weight: 720;
}

.result-card.active {
  border-color: #19372f;
}

.result-card.win.active {
  background: #e2f76f;
}

.result-card.loss.active {
  background: #ffd8b6;
}

.result-small {
  margin-top: 7rpx;
  color: #718078;
  font-size: 21rpx;
  font-weight: 500;
}

.mood-scroll {
  width: 100%;
}

.mood-row {
  display: flex;
  gap: 14rpx;
  padding-bottom: 8rpx;
}

.mood-card {
  width: 126rpx;
  height: 136rpx;
  flex: 0 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 2rpx solid rgba(25, 55, 47, 0.08);
  border-radius: 26rpx;
  background: #fffdf8;
}

.mood-card.active {
  border-color: #19372f;
  background: #e2f76f;
}

.mood-icon {
  font-size: 38rpx;
}

.mood-label {
  font-size: 22rpx;
}

.issue-panel {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 30rpx;
  background: #fff2e5;
}

.no-top {
  margin-top: 0;
}

.diary-guide {
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 20rpx;
  background: #fff2e5;
  color: #65766e;
  font-size: 22rpx;
  line-height: 1.55;
}

.diary-guide text {
  display: block;
}

.submit {
  margin-top: 46rpx;
}

.badge-celebration-overlay {
  position: fixed;
  inset: 0;
  z-index: 50;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(14, 34, 28, 0.68);
  backdrop-filter: blur(8rpx);
}

.badge-celebration-card {
  position: relative;
  width: 100%;
  padding: 54rpx 36rpx 36rpx;
  overflow: hidden;
  border-radius: 38rpx;
  background: #fffdf8;
  box-shadow: 0 28rpx 80rpx rgba(9, 29, 23, 0.28);
  text-align: center;
  animation: badge-card-in 420ms cubic-bezier(0.2, 0.9, 0.25, 1.15) both;
}

.badge-glow {
  position: absolute;
  top: -160rpx;
  left: 50%;
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(226, 247, 111, 0.62), rgba(226, 247, 111, 0));
  transform: translateX(-50%);
  animation: badge-glow-pulse 1.8s ease-in-out infinite;
}

.badge-spark {
  position: absolute;
  z-index: 2;
  color: #c5df3f;
  font-size: 34rpx;
  animation: badge-sparkle 1.4s ease-in-out infinite;
}

.badge-spark-one {
  top: 54rpx;
  left: 70rpx;
}

.badge-spark-two {
  top: 90rpx;
  right: 62rpx;
  color: #f3a672;
  animation-delay: 300ms;
}

.badge-spark-three {
  top: 178rpx;
  left: 54rpx;
  color: #19372f;
  font-size: 50rpx;
  animation-delay: 600ms;
}

.badge-unlock-label,
.badge-unlock-group,
.badge-unlock-name,
.badge-unlock-desc {
  position: relative;
  z-index: 1;
  display: block;
}

.badge-unlock-label {
  color: #61746a;
  font-size: 22rpx;
  font-weight: 720;
  letter-spacing: 2rpx;
}

.badge-unlock-icon {
  position: relative;
  z-index: 1;
  width: 154rpx;
  height: 154rpx;
  margin: 22rpx auto 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 5rpx solid #19372f;
  border-radius: 50%;
  background: #e2f76f;
  font-size: 76rpx;
  box-shadow:
    0 0 0 12rpx rgba(226, 247, 111, 0.24),
    0 18rpx 38rpx rgba(90, 112, 28, 0.2);
  animation: badge-icon-float 1.8s ease-in-out infinite;
}

.badge-unlock-group {
  color: #7b8982;
  font-size: 20rpx;
}

.badge-unlock-name {
  margin-top: 10rpx;
  color: #19372f;
  font-size: 42rpx;
  font-weight: 820;
}

.badge-unlock-desc {
  margin-top: 12rpx;
  color: #5c6e65;
  font-size: 24rpx;
  line-height: 1.55;
}

.badge-extra-list {
  position: relative;
  z-index: 1;
  margin-top: 26rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #f2f5e5;
}

.badge-extra-label {
  display: block;
  color: #718078;
  font-size: 20rpx;
}

.badge-extra-row {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
}

.badge-extra-chip {
  padding: 9rpx 14rpx;
  display: flex;
  align-items: center;
  gap: 7rpx;
  border-radius: 999rpx;
  background: #fffdf8;
  font-size: 19rpx;
}

.badge-accept-button {
  position: relative;
  z-index: 1;
  min-height: 88rpx;
  margin-top: 30rpx;
  border-radius: 24rpx;
  background: #19372f;
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 720;
}

@keyframes badge-card-in {
  from { opacity: 0; transform: translateY(36rpx) scale(0.92); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes badge-icon-float {
  0%, 100% { transform: translateY(0) rotate(-2deg); }
  50% { transform: translateY(-10rpx) rotate(2deg); }
}

@keyframes badge-glow-pulse {
  0%, 100% { opacity: 0.68; transform: translateX(-50%) scale(0.94); }
  50% { opacity: 1; transform: translateX(-50%) scale(1.06); }
}

@keyframes badge-sparkle {
  0%, 100% { opacity: 0.35; transform: scale(0.72) rotate(0); }
  50% { opacity: 1; transform: scale(1.2) rotate(18deg); }
}

.result-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 30;
  display: flex;
  align-items: flex-end;
  background: rgba(16, 35, 29, 0.52);
}

.result-sheet {
  width: 100%;
  max-height: 92vh;
  padding: 44rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
  border-radius: 44rpx 44rpx 0 0;
  background: #f7f5ec;
  text-align: center;
}

.paipai-stage {
  position: relative;
  width: 260rpx;
  height: 230rpx;
  margin: 0 auto;
}

.paipai-reply {
  position: absolute;
  left: 20rpx;
  bottom: 0;
  width: 220rpx;
  height: 220rpx;
}

.sparkle {
  position: absolute;
  z-index: 2;
  color: #d0e34d;
  font-size: 34rpx;
  animation: sparkle-pop 1.5s ease-in-out infinite;
}

.sparkle-one {
  top: 28rpx;
  left: 10rpx;
}

.sparkle-two {
  top: 4rpx;
  right: 14rpx;
  color: #f5a871;
  animation-delay: 260ms;
}

.sparkle-three {
  top: 92rpx;
  right: 0;
  color: #19372f;
  font-size: 46rpx;
  animation-delay: 520ms;
}

.saved-label,
.reply-title,
.reply-message {
  display: block;
}

.saved-label {
  margin-top: 24rpx;
  color: #738078;
  font-size: 23rpx;
}

.reply-title {
  margin-top: 24rpx;
  font-size: 42rpx;
  font-weight: 820;
}

.reply-message {
  margin-top: 22rpx;
  color: #3e554c;
  font-size: 28rpx;
  line-height: 1.78;
  text-align: left;
  white-space: pre-line;
}

.next-step {
  margin: 28rpx 0;
  padding: 25rpx 26rpx 25rpx 30rpx;
  border: 2rpx solid rgba(25, 55, 47, 0.09);
  border-left: 8rpx solid #c9df55;
  border-radius: 20rpx;
  background: #fffaf2;
  text-align: left;
}

.next-label,
.next-text {
  display: block;
}

.next-label {
  color: #7b877f;
  font-size: 20rpx;
  font-weight: 680;
  letter-spacing: 1rpx;
}

.next-text {
  margin-top: 10rpx;
  color: #233f36;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.6;
  white-space: pre-line;
}

.helpful-row {
  margin-bottom: 28rpx;
  color: #718078;
  font-size: 23rpx;
}

.helpful-actions {
  display: flex;
  justify-content: center;
  gap: 14rpx;
  margin-top: 14rpx;
}

.helpful-actions button {
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #fffdf8;
  color: #53645c;
  font-size: 22rpx;
}

.sheet-link {
  margin-top: 12rpx;
  background: transparent;
  color: #52645c;
  font-size: 24rpx;
}
