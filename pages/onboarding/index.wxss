.onboarding {
  min-height: 100vh;
  padding: 34rpx 36rpx 190rpx;
  background:
    radial-gradient(circle at 92% 6%, rgba(226, 247, 111, 0.48), transparent 26%),
    #f7f5ec;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 25rpx;
  font-weight: 760;
}

.mini-ball {
  width: 30rpx;
  height: 30rpx;
  border: 3rpx solid #19372f;
  border-radius: 50%;
  background: #e2f76f;
}

.progress {
  display: flex;
  gap: 10rpx;
  margin-top: 42rpx;
}

.progress-item {
  width: 44rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(25, 55, 47, 0.12);
}

.progress-item.active {
  width: 84rpx;
  background: #19372f;
}

.step-panel {
  margin-top: 52rpx;
}

.intro-hero {
  text-align: center;
}

.intro-hero .headline {
  margin-left: auto;
  margin-right: auto;
}

.intro-paipai {
  width: 260rpx;
  height: 220rpx;
  margin: -20rpx auto 20rpx;
  display: block;
}

.intro-comfort {
  display: block;
  margin-top: 16rpx;
  color: #4f675d;
  font-size: 24rpx;
  font-weight: 650;
}

.intro-features {
  margin-top: 36rpx;
  padding: 12rpx 28rpx;
  border: 2rpx solid rgba(25, 55, 47, 0.07);
  border-radius: 30rpx;
  background: rgba(255, 253, 248, 0.88);
}

.intro-feature {
  min-height: 112rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
  border-bottom: 2rpx solid rgba(25, 55, 47, 0.06);
}

.intro-feature:last-child {
  border-bottom: none;
}

.intro-feature-mark {
  color: #cbe84d;
  font-size: 34rpx;
  text-shadow: 0 0 0 3rpx #19372f;
}

.intro-feature-title,
.intro-feature-desc {
  display: block;
}

.intro-feature-title {
  font-size: 27rpx;
  font-weight: 760;
}

.intro-feature-desc {
  margin-top: 7rpx;
  color: #718078;
  font-size: 22rpx;
  line-height: 1.45;
}

.hello {
  display: block;
  color: #596c63;
  font-size: 27rpx;
  font-weight: 650;
}

.headline {
  display: block;
  max-width: 650rpx;
  margin-top: 14rpx;
  font-size: 58rpx;
  line-height: 1.2;
  font-weight: 820;
  letter-spacing: -2rpx;
}

.subhead {
  display: block;
  margin-top: 22rpx;
  color: #718078;
  font-size: 27rpx;
  line-height: 1.7;
}

.welcome-card {
  margin-top: 38rpx;
  min-height: 184rpx;
  padding: 24rpx 30rpx 24rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-radius: 30rpx;
  background: #dceee8;
}

.welcome-copy {
  flex: 1;
}

.paipai-onboarding {
  width: 176rpx;
  height: 154rpx;
  flex: 0 0 auto;
}

.welcome-title,
.welcome-desc,
.tone-title,
.tone-desc {
  display: block;
}

.welcome-title {
  font-size: 28rpx;
  font-weight: 760;
}

.welcome-desc {
  margin-top: 9rpx;
  color: rgba(25, 55, 47, 0.72);
  font-size: 24rpx;
  line-height: 1.55;
}

.option-list,
.tone-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.option-card,
.tone-card {
  min-height: 92rpx;
  padding: 22rpx 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid rgba(25, 55, 47, 0.08);
  border-radius: 24rpx;
  background: #fffdf8;
}

.option-card.active,
.tone-card.active {
  border-color: #19372f;
  background: #eff8bd;
}

.check,
.tone-check {
  font-size: 28rpx;
  font-weight: 800;
}

.goal-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 34rpx;
}

.goal-card {
  min-height: 112rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  border: 2rpx solid rgba(25, 55, 47, 0.08);
  border-radius: 24rpx;
  background: #fffdf8;
  font-weight: 650;
}

.goal-card.active {
  border-color: #19372f;
  background: #e2f76f;
}

.goal-other {
  margin-top: 16rpx;
}

.portrait-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.later-button {
  width: auto;
  margin: 0;
  padding: 10rpx 0 10rpx 22rpx;
  background: transparent;
  color: #667970;
  font-size: 23rpx;
  font-weight: 650;
}

.portrait-completion {
  margin-top: 30rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border: 2rpx solid rgba(25, 55, 47, 0.08);
  border-radius: 20rpx;
  background: rgba(255, 253, 248, 0.72);
  color: #718078;
  font-size: 20rpx;
}

.portrait-completion-track {
  height: 8rpx;
  overflow: hidden;
  flex: 1;
  border-radius: 999rpx;
  background: rgba(25, 55, 47, 0.1);
}

.portrait-completion-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #19372f;
  transition: width 240ms ease;
}

.portrait-question {
  margin-top: 24rpx;
  padding: 26rpx;
  border: 2rpx solid rgba(25, 55, 47, 0.07);
  border-radius: 28rpx;
  background: rgba(255, 253, 248, 0.94);
  box-shadow: 0 10rpx 26rpx rgba(25, 55, 47, 0.045);
}

.portrait-question-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.portrait-number {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #edf5f1;
  color: #587067;
  font-size: 19rpx;
  font-weight: 800;
}

.portrait-question-copy {
  flex: 1;
}

.portrait-title,
.portrait-hint {
  display: block;
}

.portrait-title {
  font-size: 27rpx;
  font-weight: 740;
  line-height: 1.42;
}

.portrait-hint {
  margin-top: 5rpx;
  color: #89958e;
  font-size: 20rpx;
}

.portrait-options {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.portrait-option {
  min-height: 76rpx;
  padding: 14rpx 16rpx 14rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx;
  border: 2rpx solid rgba(25, 55, 47, 0.07);
  border-radius: 19rpx;
  background: #f7f6ef;
  color: #50635a;
  font-size: 23rpx;
  line-height: 1.35;
}

.portrait-option.active {
  border-color: rgba(25, 55, 47, 0.78);
  background: #e2f76f;
  color: #19372f;
  font-weight: 700;
  box-shadow: 0 6rpx 14rpx rgba(126, 149, 37, 0.12);
}

.portrait-check {
  width: 27rpx;
  height: 27rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  border: 2rpx solid rgba(25, 55, 47, 0.16);
  border-radius: 50%;
  font-size: 17rpx;
}

.portrait-option.active .portrait-check {
  border-color: #19372f;
  background: #19372f;
  color: #ffffff;
}

.portrait-other {
  margin-top: 14rpx;
  padding: 0 20rpx;
  border: 2rpx solid rgba(25, 55, 47, 0.1);
  border-radius: 19rpx;
  background: #ffffff;
}

.portrait-other input {
  height: 84rpx;
  font-size: 24rpx;
}

.goal-dot {
  width: 15rpx;
  height: 15rpx;
  border: 3rpx solid #19372f;
  border-radius: 50%;
}

.tone-title {
  font-size: 27rpx;
  font-weight: 720;
}

.tone-desc {
  margin-top: 6rpx;
  color: #76847d;
  font-size: 23rpx;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 5;
  padding: 22rpx 36rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 18rpx;
  background: linear-gradient(to bottom, rgba(247, 245, 236, 0), #f7f5ec 24%);
}

.back-button {
  width: 180rpx;
  min-height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  background: #fffdf8;
  color: #19372f;
  font-size: 28rpx;
  font-weight: 650;
}

.next {
  flex: 1;
}
